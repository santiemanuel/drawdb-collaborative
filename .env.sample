PORT=3000
DATABASE_PATH=./data/drawdb.sqlite

# Server-only settings. Never use a VITE_ prefix for credentials.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra application allowlist; empty does not change the external gate.
GOOGLE_ALLOWED_EMAILS=
# Optional file-backed exact-email allowlist, e.g. /etc/drawdb/allowed-emails.txt.
# When configured it must be readable and nonempty. Both lists restrict access
# if GOOGLE_ALLOWED_EMAILS is also nonempty (intersection, never union).
# GOOGLE_ALLOWED_EMAILS_FILE=/etc/drawdb/allowed-emails.txt
